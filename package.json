{
  "name": "appium-session-recorder",
  "version": "0.0.4",
  "description": "Local Appium proxy that records interactions, screenshots, and page source",
  "type": "module",
  "bin": {
    "appium-recorder": "./dist/index.js"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "keywords": [
    "appium",
    "mobile-testing",
    "test-automation",
    "session-recorder",
    "element-inspector",
    "ios-testing",
    "android-testing",
    "qa-tools"
  ],
  "scripts": {
    "cli": "bun run src/index.ts",
    "dev": "bun run src/index.ts",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "build": "bun run build:ui && bun build src/index.ts --outdir dist --target bun --packages external",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "prepack": "bun run build",
    "test": "vitest run && vitest run --config vitest.ui.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:coverage": "vitest run --coverage && vitest run --config vitest.ui.config.ts --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json && tsc --noEmit -p src/ui/tsconfig.json",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc -p tsconfig.tests.json --noUnusedLocals --noUnusedParameters && tsc --noEmit --noUnusedLocals --noUnusedParameters -p src/ui/tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.0",
    "http-proxy-middleware": "^4.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-diff": "^1.3.0",
    "jsdom": "^30.0.1",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "JustasMonkev <> (https://github.com/JustasMonkev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustasMonkev/appium-session-recorder"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ]
}
